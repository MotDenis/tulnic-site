---
import { site } from '../data/site';

const year = new Date().getFullYear();
const tel = site.phone.replace(/[^+\d]/g, '');
---

<footer class="site-footer band">
  <div class="container cols">
    <div>
      <p class="brand">{site.name}</p>
      <p>{site.tagline}</p>
    </div>
    <div>
      <h2>Contact</h2>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={`tel:${tel}`}>{site.phone}</a><br />
        {site.hours}
      </p>
    </div>
    <div>
      <h2>Date de identificare</h2>
      <p>
        {site.name} este numele sub care lucrează {site.legal.name}.<br />
        Nr. Reg. Com.: {site.legal.regNo}<br />
        CUI: {site.legal.cui}<br />
        Sediul: {site.legal.seat}
      </p>
    </div>
  </div>
  <div class="container bottom">
    <p>© {year} {site.legal.name}</p>
    <a href="/confidentialitate/">Politica de confidențialitate</a>
    <a class="sal" href="https://reclamatiisal.anpc.ro">
      <img src="/anpc-sal.png" width="250" height="50" alt="ANPC: Soluționarea alternativă a litigiilor" />
    </a>
  </div>
</footer>

<style>
  .sal {
    line-height: 0;
  }
</style>
