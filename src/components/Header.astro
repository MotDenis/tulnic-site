---
import Logo from './Logo.astro';
import { navLinks } from '../data/site';

// "/servicii/" și "/servicii" sunt aceeași pagină
const normalize = (path: string) => (path.length > 1 ? path.replace(/\/$/, '') : path);
const current = normalize(Astro.url.pathname);
---

<header class="site-header container">
  <a class="logo" href="/"><Logo /></a>
  <nav class="site-nav" aria-label="Meniu principal">
    <ul>
      {navLinks.map((link) => (
        <li>
          <a href={link.href} aria-current={normalize(link.href) === current ? 'page' : undefined}>{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
