---
import '../styles/tokens.css';
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { openingHours, site, tel } from '../data/site';
import { areaServed, organizationId } from '../data/schema';

interface Props {
  title?: string;
  description: string;
  /** Introducerea mare, doar pe pagina de start. */
  hero?: boolean;
  /** Pagina nu apare în motoarele de căutare (de exemplu, pagina 404). */
  noindex?: boolean;
  /** Datele structurate ale paginii (de exemplu un Service cu prețuri), făcute cu funcțiile din data/schema.ts. */
  structuredData?: object | object[];
}

const { title, description, hero = false, noindex = false, structuredData } = Astro.props;
const pageTitle = !title ? site.homeTitle : title.includes(site.name) ? title : `${title} — ${site.name}`;

// Adresa canonică a paginii, mereu cu „/” la final, ca în meniu și în sitemap.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const isHome = Astro.url.pathname === '/';
const homeUrl = new URL('/', Astro.site).href;

// Datele structurate (schema.org): site-ul și firma, pe prima pagină; pe celelalte, ce trimite pagina.
const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    alternateName: ['Tulnic', 'tulnic.ro'],
    url: homeUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: site.name,
    legalName: site.legal.name,
    url: homeUrl,
    logo: new URL('/icon-192.png', Astro.site).href,
    email: site.email,
    telephone: tel,
    taxID: site.legal.cui,
    // Unde vin la sediu: București și Ilfov.
    areaServed,
    // Numele complet apare doar dacă vrei; atunci îl scrii aici în loc de „Denis”.
    founder: { '@type': 'Person', name: 'Denis', jobTitle: 'Inginer' },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      telephone: tel,
      email: site.email,
      availableLanguage: 'ro',
      hoursAvailable: openingHours,
    },
    // Profilurile aceleiași firme pe alte site-uri, ca Google să le lege între ele.
    sameAs: [site.social.facebook, site.social.google],
  },
];
const jsonLd = [...(isHome ? siteJsonLd : []), ...(structuredData ? [structuredData].flat() : [])];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#15291f" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a3326" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Cum arată linkul când e distribuit pe Facebook, LinkedIn sau WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <Font cssVariable="--font-heading" preload={[{ subset: 'latin', weight: 700 }]} />
    <Font cssVariable="--font-body" preload={[{ subset: 'latin' }]} />
  </head>
  <body>
    <a class="skip-link" href="#continut">Sari la conținut</a>
    <div class="band">
      <Header />
    </div>
    <main id="continut">
      <div class="band band-intro">
        <svg class="arcs" viewBox="0 0 300 300" preserveAspectRatio="xMaxYMax meet" aria-hidden="true">
          <circle cx="300" cy="300" r="56" />
          <circle cx="300" cy="300" r="104" />
          <circle cx="300" cy="300" r="152" />
          <circle cx="300" cy="300" r="200" />
          <circle cx="300" cy="300" r="248" />
          <circle cx="300" cy="300" r="296" />
        </svg>
        <div class:list={['intro', 'container', { 'intro-hero': hero }]}>
          <slot name="intro" />
        </div>
      </div>
      <div class="content container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>